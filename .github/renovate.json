{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "Asia/Tokyo",
  "schedule": ["at any time"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboard": true,
  "automerge": false,
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": false
  },
  "nix": {
    "enabled": false
  },
  "mise": {
    "managerFilePatterns": ["/^private_dot_config\\/mise\\/conf\\.d\\/.*\\.toml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update glab from GitLab releases",
      "managerFilePatterns": ["/^private_dot_config\\/mise\\/conf\\.d\\/managed-tools\\.toml$/"],
      "matchStrings": ["glab\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "gitlab-org/cli",
      "packageNameTemplate": "gitlab-org/cli",
      "datasourceTemplate": "gitlab-releases",
      "registryUrlTemplate": "https://gitlab.com",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update pinned bootstrap versions, keeping the mise installer checksum in sync",
      "managerFilePatterns": ["/^\\.chezmoidata\\/versions\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+\\w+: (?<currentValue>\\S+)(?:\\n\\s+\\w+Sha256: (?<currentDigest>[a-f0-9]{64}))?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Nix updates are managed by repository-owned workflows",
      "matchManagers": ["nix"],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions non-major updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github actions non-major"
    },
    {
      "description": "Automerge safe GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep bat-extras pinned because upstream release tags mix calendar formats",
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:eth-p/bat-extras"],
      "enabled": false
    },
    {
      "description": "Keep difftastic pinned because 0.71.0 lacks Apple Darwin archives",
      "matchManagers": ["mise"],
      "matchDepNames": ["difftastic"],
      "enabled": false
    },
    {
      "description": "Group mise managed tool non-major updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "mise managed tools non-major",
      "automerge": true
    },
    {
      "description": "nix-index-database tags are timestamps, not semver",
      "matchDepNames": ["nix-community/nix-index-database"],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})-(?<build>\\d+)$"
    },
    {
      "description": "Group pinned bootstrap versions",
      "matchFileNames": [".chezmoidata/versions.yaml"],
      "groupName": "pinned bootstrap versions",
      "automerge": true
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
