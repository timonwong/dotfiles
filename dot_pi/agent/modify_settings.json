{{- /* chezmoi:modify-template */ -}}
{{- $config := .chezmoi.stdin | default "{}" | fromJson | default dict -}}
{{- $config = mergeOverwrite $config (dict
  "defaultTools" (list
    "+codemode"
  )
  "theme" "dark"
  "markdown" (dict
    "mermaid" "streaming"
  )
  "steeringMode" "all"
  "followUpMode" "all"
  "terminal" (dict
    "showTerminalProgress" true
  )
  "retry" (dict
    "maxRetries" 5
    "baseDelayMs" 5000
  )
  "tuiMode" "fullscreen"
  "packages" (list
    "npm:@ff-labs/pi-fff"
    "npm:@fradser/pi-agent-teams"
    "npm:@fradser/pi-btw"
    "npm:@fradser/pi-monitor"
    "npm:@fradser/pi-utils"
    "npm:@juicesharp/rpiv-ask-user-question"
    "npm:nowledge-mem-pi"
    "npm:pi-context-usage"
    "npm:pi-prompt-template-model"
    "npm:pi-rtk-optimizer"
    "npm:pi-smart-fetch"
    "npm:pi-smart-web-search"
    "npm:pi-subagents"
    "npm:pi-tool-display"
  )
) -}}
{{- $config | toPrettyJson -}}
