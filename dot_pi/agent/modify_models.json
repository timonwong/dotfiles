{{- /* chezmoi:modify-template */ -}}
{{- $config := .chezmoi.stdin | default "{}" | fromJson | default dict -}}
{{- $managed := include ".chezmoidata/pi-models.yaml" | fromYaml | default dict -}}
{{- $managed = get $managed "pi" | default dict -}}
{{- $providers := get $config "providers" | default dict -}}
{{- $cpa := get $providers "cpa" | default dict -}}
{{- $managedCpa := get $managed "cpa" | default dict -}}
{{- $cpa = mergeOverwrite $cpa $managedCpa -}}
{{- $providers = mergeOverwrite $providers (dict "cpa" $cpa) -}}
{{- $config = mergeOverwrite $config (dict "providers" $providers) -}}
{{- $config | toPrettyJson -}}
