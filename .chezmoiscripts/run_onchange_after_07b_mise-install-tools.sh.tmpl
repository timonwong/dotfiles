#!/usr/bin/env bash

set -euo pipefail

{{ $miseSourceConfig := joinPath .chezmoi.sourceDir "private_dot_config/mise/config.toml.tmpl" -}}
{{ $miseSourceManagedTools := joinPath .chezmoi.sourceDir "private_dot_config/mise/conf.d/managed-tools.toml" -}}
# mise source config render: {{ includeTemplate $miseSourceConfig . | sha256sum }}
# mise source managed tools: {{ include $miseSourceManagedTools | sha256sum }}

# chezmoi may be updating dot-directories (e.g. ~/.claude). If the current working
# directory disappears mid-apply, mise will warn. Run mise from a stable dir.
cd "$HOME"

echo ":: [07b] Installing mise tools"

mise_cmd="$(command -v mise 2>/dev/null || true)"
if [[ -z "$mise_cmd" ]] || [[ ! -x "$mise_cmd" ]]; then
    mise_cmd="$HOME/.local/bin/mise"
fi
if [[ ! -x "$mise_cmd" ]]; then
    echo "    Skipped (mise not found)"
    exit 0
fi

# Ensure mise shims are available in this non-interactive shell.
eval "$("$mise_cmd" activate bash)"

# Use aube as backend for node packages
if ! command -v npm &>/dev/null; then
    "$mise_cmd" install --yes node
    eval "$("$mise_cmd" activate bash)"
fi

"$mise_cmd" install --yes
"$mise_cmd" reshim
