#!/usr/bin/env bash

set -euo pipefail

{{ $skillsYamlRel := "private_dot_config/skimi/skills.yaml.tmpl" -}}
{{ $skillsYaml := joinPath .chezmoi.sourceDir $skillsYamlRel -}}
{{ $skillsDigest := output "sh" "-c" (printf "cd %q && if [ -d private_dot_config/skimi/skills ]; then find private_dot_config/skimi/skills -type f -exec shasum -a 256 {} +; fi | LC_ALL=C sort | shasum -a 256 | awk '{print $1}'" .chezmoi.sourceDir) | trim -}}
# {{ $skillsYamlRel }}: {{ if stat $skillsYaml }}{{ includeTemplate $skillsYaml . | sha256sum }}{{ else }}n/a{{ end }}
# private_dot_config/skimi/skills digest: {{ $skillsDigest }}

echo ":: [10] Syncing skimi skills"

if ! command -v rsync >/dev/null 2>&1; then
    echo "    Error: rsync is required" >&2
    exit 1
fi

sync_tree() {
    local source_dir="$1"
    local target_dir="$2"
    local label="$3"

    if [[ ! -d "$source_dir" ]]; then
        echo "    Skipped ${label} (source not found)"
        return 0
    fi

    mkdir -p "$target_dir"
    rsync -a --delete "$source_dir"/ "$target_dir"/
    echo "    Synced ${label}: ${target_dir/#$HOME/~}"
}

skills_source_dir="{{ joinPath .chezmoi.sourceDir "private_dot_config/skimi/skills" }}"
skills_target_dir="{{ joinPath .chezmoi.homeDir ".config/skimi/skills" }}"

sync_tree "$skills_source_dir" "$skills_target_dir" "local skills"

while IFS= read -r sh_file; do
    chmod 755 "$sh_file"
done < <(find "$skills_target_dir" -type f -name '*.sh' 2>/dev/null | LC_ALL=C sort)
echo "    Updated executable mode for *.sh"

{{ include ".chezmoitemplates/shell/source_nix_env.sh" }}
if [[ -d "$HOME/.nix-profile/bin" ]]; then
    export PATH="$HOME/.nix-profile/bin:$PATH"
fi

mise_cmd="$(command -v mise 2>/dev/null || true)"
if [[ -z "$mise_cmd" ]] || [[ ! -x "$mise_cmd" ]]; then
    mise_cmd="$HOME/.local/bin/mise"
fi
if [[ ! -x "$mise_cmd" ]]; then
    echo "    Skipped (mise not found)"
    exit 0
fi

eval "$("$mise_cmd" activate bash)"

if ! command -v skimi >/dev/null 2>&1; then
    echo "    Error: skimi not found after mise activation" >&2
    exit 1
fi

echo "    Running: skimi install"
skimi install
