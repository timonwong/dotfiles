#!/usr/bin/env bash

set -euo pipefail

{{ include ".chezmoitemplates/shell/source_nix_env.sh" }}
if [[ -d "$HOME/.nix-profile/bin" ]]; then
    export PATH="$HOME/.nix-profile/bin:$PATH"
fi
PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
if [[ -n "${RIME_WANXIANG_PATH_PREFIX:-}" ]]; then
    PATH="$RIME_WANXIANG_PATH_PREFIX:$PATH"
fi

WANXIANG_REPO_URL="https://github.com/amzxyz/rime-wanxiang"
WANXIANG_VERSION="v18.1.9"
WANXIANG_ZIP_URL="${WANXIANG_REPO_URL}/releases/download/${WANXIANG_VERSION}/rime-wanxiang-base.zip"
WANXIANG_GRAM_URL="https://github.com/amzxyz/RIME-LMDG/releases/download/LTS/wanxiang-lts-zh-hans.gram"
WANXIANG_GRAM_FILENAME="wanxiang-lts-zh-hans.gram"
SQUIRREL_BIN="${SQUIRREL_BIN:-/Library/Input Methods/Squirrel.app/Contents/MacOS/Squirrel}"

echo ":: [12] Syncing rime-wanxiang"
echo "    Source: ${WANXIANG_REPO_URL}"
echo "    Version: ${WANXIANG_VERSION}"
{{- if .headless }}
echo "    Skipped (headless profile)"
exit 0
{{- end }}

platform="{{ .chezmoi.os }}"
case "$platform" in
darwin)
    TARGET_DIR="$HOME/Library/Rime"
    PLATFORM_FILE="squirrel.yaml"
    ;;
linux)
    TARGET_DIR="$HOME/.config/ibus/rime"
    PLATFORM_FILE="ibus_rime.yaml"
    ;;
*)
    echo "    Skipped (unsupported OS: $platform)"
    exit 0
    ;;
esac

GRAM_TARGET_FILE="$TARGET_DIR/$WANXIANG_GRAM_FILENAME"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rime-wanxiang"
INSTALLED_VERSION_FILE="$STATE_DIR/installed_version"
UPSTREAM_MANAGED_FILES_FILE="$STATE_DIR/upstream-managed-files.txt"
LEGACY_OH_MY_RIME_MANIFEST="${XDG_STATE_HOME:-$HOME/.local/state}/oh-my-rime/upstream-managed-files.txt"

pretty_path() {
    local path="$1"
    printf '%s\n' "${path/#$HOME/~}"
}

download_file() {
    local url="$1"
    local output="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --retry 3 "$url" -o "$output"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$output" "$url"
    else
        echo "    Error: curl or wget is required" >&2
        exit 1
    fi
}

manifest_is_complete() {
    local manifest_file="$1"

    [[ -s "$manifest_file" ]] || return 1

    while IFS= read -r rel; do
        [[ -n "$rel" ]] || continue
        [[ -e "$TARGET_DIR/$rel" ]] || return 1
    done <"$manifest_file"
}

copy_file() {
    local repo_root="$1"
    local rel="$2"
    local manifest="$3"
    local src="$repo_root/$rel"
    local dst="$TARGET_DIR/$rel"

    [[ -f "$src" ]] || return 0
    mkdir -p "$(dirname "$dst")"
    cp -f "$src" "$dst"
    printf '%s\n' "$rel" >>"$manifest"
}

copy_dir_files() {
    local repo_root="$1"
    local dir_rel="$2"
    local manifest="$3"
    local src_dir="$repo_root/$dir_rel"

    [[ -d "$src_dir" ]] || return 0

    while IFS= read -r src; do
        [[ -n "$src" ]] || continue
        local rel="${src#"$repo_root"/}"
        local dst="$TARGET_DIR/$rel"
        mkdir -p "$(dirname "$dst")"
        cp -f "$src" "$dst"
        printf '%s\n' "$rel" >>"$manifest"
    done < <(find "$src_dir" -type f | LC_ALL=C sort)
}

prune_empty_dirs() {
    local dir="$1"

    while [[ "$dir" != "$TARGET_DIR" && "$dir" != "/" ]]; do
        rmdir "$dir" 2>/dev/null || break
        dir="$(dirname "$dir")"
    done
}

remove_stale_managed_files() {
    local manifest="$1"
    local new_manifest="$2"

    [[ -f "$manifest" ]] || return 0

    while IFS= read -r rel; do
        [[ -n "$rel" ]] || continue
        if ! grep -qxF "$rel" "$new_manifest"; then
            rm -f "$TARGET_DIR/$rel"
            prune_empty_dirs "$(dirname "$TARGET_DIR/$rel")"
        fi
    done <"$manifest"
}

combine_previous_manifests() {
    local combined="$1"

    : >"$combined"
    if [[ -f "$UPSTREAM_MANAGED_FILES_FILE" ]]; then
        cat "$UPSTREAM_MANAGED_FILES_FILE" >>"$combined"
    fi
    if [[ -f "$LEGACY_OH_MY_RIME_MANIFEST" ]]; then
        cat "$LEGACY_OH_MY_RIME_MANIFEST" >>"$combined"
    fi
}
{{ include ".chezmoitemplates/shell/rime_deploy.sh" }}
mkdir -p "$STATE_DIR"
if [[ ! -d "$TARGET_DIR" ]]; then
    mkdir -p "$TARGET_DIR"
    echo "    Created: $(pretty_path "$TARGET_DIR")"
fi

gram_tmp="$(mktemp "$TARGET_DIR/${WANXIANG_GRAM_FILENAME}.XXXXXX")"
download_file "$WANXIANG_GRAM_URL" "$gram_tmp"
mv -f "$gram_tmp" "$GRAM_TARGET_FILE"
echo "    Synced grammar: $(pretty_path "$GRAM_TARGET_FILE")"

if [[ -f "$INSTALLED_VERSION_FILE" ]] && [[ "$(cat "$INSTALLED_VERSION_FILE")" == "$WANXIANG_VERSION" ]] && manifest_is_complete "$UPSTREAM_MANAGED_FILES_FILE"; then
    echo "    Upstream already synced: $(pretty_path "$TARGET_DIR")"
else
    tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/rime-wanxiang.XXXXXX")"
    cleanup() {
        rm -rf "$tmpdir"
    }
    trap cleanup EXIT

    archive_file="$tmpdir/rime-wanxiang-base.zip"
    extract_dir="$tmpdir/extract"
    new_upstream_manifest="$tmpdir/upstream-managed-files.txt"
    previous_manifest="$tmpdir/previous-managed-files.txt"

    mkdir -p "$extract_dir"
    : >"$new_upstream_manifest"

    if ! command -v unzip >/dev/null 2>&1; then
        echo "    Error: unzip is required to extract rime-wanxiang" >&2
        exit 1
    fi

    download_file "$WANXIANG_ZIP_URL" "$archive_file"
    unzip -q "$archive_file" -d "$extract_dir"

    repo_root=""
    if [[ -f "$extract_dir/wanxiang.schema.yaml" ]]; then
        repo_root="$extract_dir"
    else
        repo_root="$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
    fi
    if [[ -z "$repo_root" ]]; then
        echo "    Error: failed to locate extracted rime-wanxiang sources" >&2
        exit 1
    fi

    while IFS= read -r src; do
        [[ -n "$src" ]] || continue
        rel="$(basename "$src")"

        case "$rel" in
        ibus_rime.yaml | squirrel.yaml)
            [[ "$PLATFORM_FILE" == "$rel" ]] || continue
            copy_file "$repo_root" "$rel" "$new_upstream_manifest"
            ;;
        weasel.yaml)
            continue
            ;;
        README.md | LICENSE | CHANGELOG.md | AGENTS.md | mkdocs.yml | .gitattributes | .gitignore | .yamlfmt)
            continue
            ;;
        *.yaml | *.txt | rime.lua)
            copy_file "$repo_root" "$rel" "$new_upstream_manifest"
            ;;
        esac
    done < <(find "$repo_root" -mindepth 1 -maxdepth 1 -type f | LC_ALL=C sort)

    copy_dir_files "$repo_root" "dicts" "$new_upstream_manifest"
    copy_dir_files "$repo_root" "lua" "$new_upstream_manifest"
    copy_dir_files "$repo_root" "opencc" "$new_upstream_manifest"

    LC_ALL=C sort -u "$new_upstream_manifest" -o "$new_upstream_manifest"
    combine_previous_manifests "$previous_manifest"
    remove_stale_managed_files "$previous_manifest" "$new_upstream_manifest"
    cp "$new_upstream_manifest" "$UPSTREAM_MANAGED_FILES_FILE"
    printf '%s\n' "$WANXIANG_VERSION" >"$INSTALLED_VERSION_FILE"
    echo "    Synced upstream: $(pretty_path "$TARGET_DIR")"
fi

deploy_rime
