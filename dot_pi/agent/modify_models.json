{{- /* chezmoi:modify-template */ -}}
{{- $config := .chezmoi.stdin | default "{}" | fromJson | default dict -}}
{{- $providers := get $config "providers" | default dict -}}
{{- $cpa := get $providers "cpa" | default dict -}}
{{- $managed := fromJson `
{
  "baseUrl": "http://localhost:8317/v1",
  "api": "openai-responses",
  "compact": {
    "maxTokensField": "max_tokens"
  },
  "models": [
    {
      "id": "deepseek-v4-flash",
      "name": "DeepSeek V4 Flash",
      "input": ["text"],
      "contextWindow": 1000000,
      "maxTokens": 384000,
      "reasoning": true,
      "thinkingLevelMap": {
        "minimal": null,
        "low": "low",
        "medium": null,
        "high": "high",
        "xhigh": null,
        "max": "max"
      },
      "cost": {
        "input": 0.14,
        "output": 0.28,
        "cacheRead": 0.028,
        "cacheWrite": 0
      },
      "compat": {
        "thinkingFormat": "chat-template",
        "chatTemplateKwargs": {
          "thinking": {
            "$var": "thinking.enabled"
          },
          "reasoning_effort": {
            "$var": "thinking.effort",
            "omitWhenOff": true
          }
        }
      }
    },
    {
      "id": "deepseek-v4-pro",
      "name": "DeepSeek V4 Pro",
      "input": ["text"],
      "contextWindow": 1000000,
      "maxTokens": 384000,
      "reasoning": true,
      "thinkingLevelMap": {
        "minimal": null,
        "low": "low",
        "medium": null,
        "high": "high",
        "xhigh": null,
        "max": "max"
      },
      "cost": {
        "input": 1.74,
        "output": 3.48,
        "cacheRead": 0.145,
        "cacheWrite": 0
      },
      "compat": {
        "thinkingFormat": "chat-template",
        "chatTemplateKwargs": {
          "thinking": {
            "$var": "thinking.enabled"
          },
          "reasoning_effort": {
            "$var": "thinking.effort",
            "omitWhenOff": true
          }
        }
      }
    }
  ]
}
` -}}
{{- $cpa = mergeOverwrite $cpa $managed -}}
{{- $providers = mergeOverwrite $providers (dict "cpa" $cpa) -}}
{{- $config = mergeOverwrite $config (dict "providers" $providers) -}}
{{- $config | toPrettyJson -}}
