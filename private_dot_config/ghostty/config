# vim: ft=conf
theme = Catppuccin Mocha

custom-shader = shaders/bloom025.glsl
custom-shader = shaders/cursor_blaze_no_trail.glsl
custom-shader = shaders/cursor_smear.glsl

cursor-style = block

font-family = "CommitMono Nerd Font"
font-size = 13
font-feature = -liga, -calt

# font-awesome
font-codepoint-map = U+f000-U+f2e0,U+e200-U+e2a9=JetBrainsMono Nerd Font

# seti-ui
font-codepoint-map = U+e5fa-U+e6b1=JetBrainsMono Nerd Font

# codicons
font-codepoint-map = U+ea60-U+ebeb=JetBrainsMono Nerd Font

font-thicken = true
font-thicken-strength = 40

#adjust-cell-height = 1
#adjust-cell-width = -1

window-decoration = true
window-padding-x = 12,8
window-padding-y = 0,2

macos-titlebar-proxy-icon = hidden
macos-titlebar-style = tabs
macos-option-as-alt = true
mouse-hide-while-typing = true

shell-integration = detect
shell-integration-features = true

desktop-notifications = true
bell-features = audio,attention,title,border
bell-audio-path = sounds/csnd.aif

# Background
background-opacity = 0.97
background-blur = true
unfocused-split-opacity = 0.9
unfocused-split-fill = #a33503
split-divider-color = #ff4f00

# Performance & Scrollback
scrollback-limit = 100_000_000
link-url = true

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# Quick Terminal
keybind = global:super+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 40%, 100%
quick-terminal-autohide = true

keybind = shift+enter=text:\n

# keep consistent behavior with Zellij
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# Unbind special keys so they will be forwarded to Zellij
keybind = cmd+opt+left=unbind
keybind = cmd+opt+right=unbind
keybind = opt+left=unbind
keybind = opt+right=unbind
keybind = opt+up=unbind
keybind = opt+down=unbind
